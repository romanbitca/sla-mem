{
  "name": "sla-mem",
  "productName": "Slamem",
  "version": "0.3.2",
  "private": true,
  "description": "Keeps a permanent, private, searchable copy of your own Slack history on your computer.",
  "author": "Roman Bitca <me@romanbitca.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/romanbitca/sla-mem",
  "repository": {
    "type": "git",
    "url": "https://github.com/romanbitca/sla-mem.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "cross-env SLA_MEM_DATA_DIR=./.demo-data electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed.ts --out ./.demo-data --messages 10000",
    "mock:slack": "tsx test/mock-slack/cli.ts",
    "gen:emoji": "tsx scripts/gen-emoji.ts",
    "icons": "electron scripts/make-icons.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "bench": "tsx scripts/bench.ts",
    "dev:mock": "cross-env SLA_MEM_DATA_DIR=./.mock-data SLA_MEM_SLACK_API=http://127.0.0.1:4849/api SLA_MEM_SLACK_WEB=http://127.0.0.1:4849 electron-vite dev",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "emoji-datasource": "^16.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
